# Copy this file to .env (same folder as docker-compose.yml) and fill in
# whichever values you use. .env is already excluded from git and from the
# Docker build context (see .dockerignore) — your keys never get committed
# or baked into the image; docker-compose just reads them at container
# start and passes them in as environment variables.
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up --build -d

# --- Twelve Data (primary market-data source when set) ---
# Free tier: 800 calls/day, 8/min, no credit card. Get a key at:
# https://twelvedata.com/pricing
# When this is set, backend/data/candles.py uses Twelve Data as the primary
# source for both historical fetches and live candle checks, falling back
# to yfinance only if a Twelve Data call fails or returns nothing. Leave
# blank to run yfinance-only (the old default) — no calls are made to
# Twelve Data if this is unset.
TWELVE_DATA_API_KEY=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OANDA (optional — only needed if EXECUTE_ENABLED=true) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
